# Vite only exposes variables prefixed with VITE_ to client code. That prefix
# is a safety rail: anything here is compiled INTO the bundle and is publicly
# readable by anyone who opens devtools. Never put a secret in this file.

# Leave empty for local development so requests are same-origin and Vite's dev
# proxy forwards /api to the API on :8080.
VITE_API_BASE_URL=

# In deployment the API is a different origin, fronted by API Gateway:
# VITE_API_BASE_URL=https://api.example.com
