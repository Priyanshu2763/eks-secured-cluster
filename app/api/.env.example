# Copy to .env for local development. NEVER commit .env.
#
# In a deployed environment these come from two places, and the split matters:
#   - non-secret config  -> task definition environment / ConfigMap
#   - secrets            -> Secrets Manager or SSM, injected at container start
# Mixing them means a table-name change requires touching your secret store.

NODE_ENV=development
PORT=8080
LOG_LEVEL=debug

AWS_REGION=ap-south-1

# ---- S3 (app account) -------------------------------------------------------
MEDIA_BUCKET=CHANGE_ME-mediavault-dev-media
UPLOAD_PREFIX=uploads/
PRESIGN_PUT_TTL_SECONDS=300
PRESIGN_GET_TTL_SECONDS=900
MAX_UPLOAD_BYTES=209715200
ALLOWED_CONTENT_TYPES=video/mp4,video/webm,audio/mpeg,audio/wav,audio/ogg

# ---- DynamoDB (data account, reached by assuming a role) --------------------
# Leave DDB_ROLE_ARN unset to use your local profile directly - the usual
# choice for development against tables in your own account.
# DDB_ROLE_ARN=arn:aws:iam::222222222222:role/mediavault-dev-dynamodb-access
DDB_ROLE_SESSION_NAME=mediavault-api
# DDB_EXTERNAL_ID=       # SECRET - from Secrets Manager / SSM in deployment

TABLE_ITEMS=mediavault-dev-items
TABLE_UPLOADS=mediavault-dev-uploads
TABLE_AUDIT=mediavault-dev-audit
GSI_FEED=gsi1-feed
GSI_TYPE=gsi2-type

# ---- HTTP -------------------------------------------------------------------
# Keep CORS_ENABLED=false in deployment: API Gateway owns CORS there, and two
# sources of Access-Control-Allow-Origin makes the browser reject the response.
# Set true locally so the Vite dev server on :5173 can reach this API.
CORS_ENABLED=true
CORS_ORIGIN=http://localhost:5173

RATE_LIMIT_PRESIGN_PER_MIN=10
UPLOAD_TICKET_TTL_SECONDS=3600
AUDIT_TTL_DAYS=30

MAX_PAGE_SIZE=50
DEFAULT_PAGE_SIZE=20
